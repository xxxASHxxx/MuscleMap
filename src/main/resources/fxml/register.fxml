<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.musclemmap.controllers.RegisterController"
           style="-fx-background-color: #0a0a0a;">

    <!-- Background Layer -->
    <VBox alignment="CENTER" spacing="0"
          style="-fx-background-color: 
                 linear-gradient(from 0% 0% to 100% 100%, 
                 #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);"/>
    
    <!-- Main Content Container -->
    <ScrollPane fitToWidth="true" fitToHeight="true" 
                style="-fx-background-color: transparent; -fx-background: transparent;"
                hbarPolicy="NEVER">
        <VBox alignment="CENTER" spacing="25" style="-fx-padding: 30px 40px 50px 40px;">
            
            <!-- Logo & Branding Section -->
            <VBox alignment="CENTER" spacing="8">
                <HBox alignment="CENTER" spacing="8">
                    <Label text="💪"
                           style="-fx-font-size: 48px;"/>
                    <VBox alignment="CENTER_LEFT" spacing="0">
                        <Label text="MUSCLE MAP"
                               style="-fx-text-fill: #4CAF50; 
                                      -fx-font-size: 38px; 
                                      -fx-font-weight: bold; 
                                      -fx-letter-spacing: 2px;
                                      -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.7), 12, 0.6, 0, 0);"/>
                        <Label text="PRO FITNESS PLATFORM"
                               style="-fx-text-fill: #ffffff; 
                                      -fx-font-size: 11px; 
                                      -fx-font-weight: 600;
                                      -fx-letter-spacing: 3px;"/>
                    </VBox>
                </HBox>
                
                <Label text="Start Your Transformation Journey Today"
                       style="-fx-text-fill: #aaaaaa; 
                              -fx-font-size: 13px; 
                              -fx-font-weight: 500;
                              -fx-font-style: italic;"/>
            </VBox>

            <!-- Register Form Container -->
            <VBox alignment="CENTER" spacing="16"
                  style="-fx-background-color: rgba(20, 20, 20, 0.95); 
                         -fx-background-radius: 20px; 
                         -fx-padding: 35px 40px; 
                         -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.25), 20, 0, 0, 6);
                         -fx-border-color: rgba(76,175,80,0.4);
                         -fx-border-width: 2px;
                         -fx-border-radius: 20px;"
                  maxWidth="420"
                  minWidth="420">

                <!-- Form Header -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="🔥 JOIN THE ELITE 🔥"
                           style="-fx-text-fill: #ffffff; 
                                  -fx-font-size: 24px; 
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 1px;"/>
                    <Label text="Create your account and unlock all features"
                           style="-fx-text-fill: #bbbbbb; 
                                  -fx-font-size: 12px; 
                                  -fx-font-weight: 500;"/>
                </VBox>

                <!-- Username Field -->
                <VBox spacing="6">
                    <Label text="USERNAME"
                           style="-fx-text-fill: #4CAF50; 
                                  -fx-font-size: 11px; 
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 1px;"/>
                    <TextField fx:id="usernameField"
                               promptText="Choose your unique username"
                               style="-fx-background-color: rgba(30, 30, 30, 0.9); 
                                      -fx-text-fill: white; 
                                      -fx-prompt-text-fill: #777777; 
                                      -fx-background-radius: 10px; 
                                      -fx-padding: 14px 18px; 
                                      -fx-font-size: 14px;
                                      -fx-font-weight: 500;
                                      -fx-border-color: rgba(76,175,80,0.3); 
                                      -fx-border-width: 1.5px;
                                      -fx-border-radius: 10px;"/>
                </VBox>

                <!-- Email Field -->
                <VBox spacing="6">
                    <Label text="EMAIL ADDRESS"
                           style="-fx-text-fill: #4CAF50; 
                                  -fx-font-size: 11px; 
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 1px;"/>
                    <TextField fx:id="emailField"
                               promptText="your.email@example.com"
                               style="-fx-background-color: rgba(30, 30, 30, 0.9); 
                                      -fx-text-fill: white; 
                                      -fx-prompt-text-fill: #777777; 
                                      -fx-background-radius: 10px; 
                                      -fx-padding: 14px 18px; 
                                      -fx-font-size: 14px;
                                      -fx-font-weight: 500;
                                      -fx-border-color: rgba(76,175,80,0.3); 
                                      -fx-border-width: 1.5px;
                                      -fx-border-radius: 10px;"/>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="6">
                    <Label text="PASSWORD"
                           style="-fx-text-fill: #4CAF50; 
                                  -fx-font-size: 11px; 
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 1px;"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="Create a strong password"
                                   style="-fx-background-color: rgba(30, 30, 30, 0.9); 
                                          -fx-text-fill: white; 
                                          -fx-prompt-text-fill: #777777; 
                                          -fx-background-radius: 10px; 
                                          -fx-padding: 14px 18px; 
                                          -fx-font-size: 14px;
                                          -fx-font-weight: 500;
                                          -fx-border-color: rgba(76,175,80,0.3); 
                                          -fx-border-width: 1.5px;
                                          -fx-border-radius: 10px;"/>
                    <Label fx:id="passwordStrengthLabel"
                           style="-fx-text-fill: #FFA726; 
                                  -fx-font-size: 11px;
                                  -fx-font-weight: 600;"/>
                </VBox>

                <!-- Confirm Password Field -->
                <VBox spacing="6">
                    <Label text="CONFIRM PASSWORD"
                           style="-fx-text-fill: #4CAF50; 
                                  -fx-font-size: 11px; 
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 1px;"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   promptText="Re-enter your password"
                                   style="-fx-background-color: rgba(30, 30, 30, 0.9); 
                                          -fx-text-fill: white; 
                                          -fx-prompt-text-fill: #777777; 
                                          -fx-background-radius: 10px; 
                                          -fx-padding: 14px 18px; 
                                          -fx-font-size: 14px;
                                          -fx-font-weight: 500;
                                          -fx-border-color: rgba(76,175,80,0.3); 
                                          -fx-border-width: 1.5px;
                                          -fx-border-radius: 10px;"/>
                </VBox>

                <!-- Error Label -->
                <Label fx:id="errorLabel"
                       wrapText="true"
                       style="-fx-text-fill: #ff5555; 
                              -fx-font-size: 11px; 
                              -fx-font-weight: bold;
                              -fx-padding: 8px 12px;
                              -fx-background-color: rgba(255,85,85,0.15);
                              -fx-background-radius: 8px;
                              -fx-border-color: rgba(255,85,85,0.3);
                              -fx-border-width: 1px;
                              -fx-border-radius: 8px;"/>

                <!-- Register Button -->
                <Button fx:id="registerButton"
                        text="🚀 CREATE ACCOUNT"
                        onAction="#handleRegister"
                        maxWidth="Infinity"
                        style="-fx-background-color: 
                               linear-gradient(to right, #4CAF50 0%, #45a049 100%); 
                               -fx-text-fill: white; 
                               -fx-font-size: 16px; 
                               -fx-font-weight: bold; 
                               -fx-letter-spacing: 2px;
                               -fx-background-radius: 12px; 
                               -fx-padding: 16px; 
                               -fx-cursor: hand; 
                               -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.5), 12, 0, 0, 4);"/>

                <!-- Password Requirements -->
                <VBox spacing="5" 
                      style="-fx-padding: 10px 14px; 
                             -fx-background-color: rgba(76,175,80,0.1);
                             -fx-background-radius: 10px;
                             -fx-border-color: rgba(76,175,80,0.3);
                             -fx-border-width: 1px;
                             -fx-border-radius: 10px;">
                    <Label text="🔒 PASSWORD REQUIREMENTS"
                           style="-fx-text-fill: #4CAF50; 
                                  -fx-font-size: 10px; 
                                  -fx-font-weight: bold;
                                  -fx-letter-spacing: 1px;"/>
                    <HBox spacing="15">
                        <VBox spacing="3">
                            <Label text="✓ At least 6 characters"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                            <Label text="✓ One uppercase letter"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                        </VBox>
                        <VBox spacing="3">
                            <Label text="✓ One lowercase letter"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                            <Label text="✓ One number"
                                   style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Divider -->
                <Separator style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 3px 0;"/>

                <!-- Login Link -->
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Already have an account?"
                           style="-fx-text-fill: #cccccc; 
                                  -fx-font-size: 12px;
                                  -fx-font-weight: 500;"/>
                    <Button fx:id="backToLoginButton"
                            text="LOGIN HERE"
                            onAction="#handleBackToLogin"
                            style="-fx-background-color: transparent; 
                                   -fx-text-fill: #4CAF50; 
                                   -fx-font-size: 12px; 
                                   -fx-font-weight: bold;
                                   -fx-underline: true; 
                                   -fx-cursor: hand;
                                   -fx-padding: 0;"/>
                </HBox>

                <!-- Features Highlight -->
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 12px 0 0 0;">
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="FREE"
                               style="-fx-text-fill: #4CAF50; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="Forever"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.2);"/>
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="INSTANT"
                               style="-fx-text-fill: #4CAF50; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="Access"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                    </VBox>
                    <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.2);"/>
                    <VBox alignment="CENTER" spacing="4">
                        <Label text="24/7"
                               style="-fx-text-fill: #4CAF50; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="Available"
                               style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Footer -->
            <VBox alignment="CENTER" spacing="3">
                <Label text="© 2025 MuscleMap Pro · All rights reserved"
                       style="-fx-text-fill: #666666; 
                              -fx-font-size: 10px;
                              -fx-font-weight: 500;"/>
                <Label text="Built for Champions 🏆"
                       style="-fx-text-fill: #888888; 
                              -fx-font-size: 9px;
                              -fx-font-style: italic;"/>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
