<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.musclemmap.controllers.RegisterController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: linear-gradient(to bottom, #1a1a2e, #16213e); -fx-padding: 40;">

    <VBox alignment="CENTER" spacing="10">
        <Label text="💪 MUSCLEMAP"
               style="-fx-text-fill: #00d4ff; -fx-font-size: 42px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, #00d4ff, 10, 0.5, 0, 0);"/>
        <Label text="Start Your Transformation Today"
               style="-fx-text-fill: #ffffff; -fx-font-size: 16px; -fx-font-style: italic;"/>
    </VBox>

    <VBox alignment="CENTER" spacing="15"
          style="-fx-background-color: rgba(30, 30, 30, 0.9); -fx-background-radius: 20px; -fx-padding: 40px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 20, 0, 0, 5);"
          maxWidth="400">

        <Label text="Create Your Account"
               style="-fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-font-weight: bold;"/>

        <VBox spacing="5">
            <Label text="Username"
                   style="-fx-text-fill: #b0b0b0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField"
                       promptText="Choose a username (min 3 characters)"
                       style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #707070; -fx-background-radius: 10px; -fx-padding: 12px; -fx-font-size: 14px; -fx-border-color: #444444; -fx-border-radius: 10px;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Email"
                   style="-fx-text-fill: #b0b0b0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <TextField fx:id="emailField"
                       promptText="your.email@example.com"
                       style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #707070; -fx-background-radius: 10px; -fx-padding: 12px; -fx-font-size: 14px; -fx-border-color: #444444; -fx-border-radius: 10px;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Password"
                   style="-fx-text-fill: #b0b0b0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Create a strong password"
                           style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #707070; -fx-background-radius: 10px; -fx-padding: 12px; -fx-font-size: 14px; -fx-border-color: #444444; -fx-border-radius: 10px;"/>
            <Label fx:id="passwordStrengthLabel"
                   style="-fx-text-fill: #FFA726; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Confirm Password"
                   style="-fx-text-fill: #b0b0b0; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <PasswordField fx:id="confirmPasswordField"
                           promptText="Re-enter your password"
                           style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-prompt-text-fill: #707070; -fx-background-radius: 10px; -fx-padding: 12px; -fx-font-size: 14px; -fx-border-color: #444444; -fx-border-radius: 10px;"/>
        </VBox>

        <Label fx:id="errorLabel"
               wrapText="true"
               style="-fx-text-fill: #ff5555; -fx-font-size: 12px; -fx-font-weight: bold;"/>

        <Button fx:id="registerButton"
                text="🚀 CREATE ACCOUNT"
                onAction="#handleRegister"
                maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 15px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.5), 10, 0, 0, 0);"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?"
                   style="-fx-text-fill: #b0b0b0; -fx-font-size: 12px;"/>
            <Button fx:id="backToLoginButton"
                    text="Login here"
                    onAction="#handleBackToLogin"
                    style="-fx-background-color: transparent; -fx-text-fill: #00d4ff; -fx-font-size: 12px; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>

        <VBox spacing="3" style="-fx-padding: 10 0 0 0;">
            <Label text="Password Requirements:"
                   style="-fx-text-fill: #909090; -fx-font-size: 10px; -fx-font-weight: bold;"/>
            <Label text="• At least 6 characters"
                   style="-fx-text-fill: #808080; -fx-font-size: 9px;"/>
            <Label text="• One uppercase letter"
                   style="-fx-text-fill: #808080; -fx-font-size: 9px;"/>
            <Label text="• One lowercase letter"
                   style="-fx-text-fill: #808080; -fx-font-size: 9px;"/>
            <Label text="• One number"
                   style="-fx-text-fill: #808080; -fx-font-size: 9px;"/>
        </VBox>
    </VBox>

    <Label text="© 2025 MuscleMap. All rights reserved."
           style="-fx-text-fill: #707070; -fx-font-size: 10px;"/>
</VBox>
