<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.musclemmap.controllers.LoginController"
           style="-fx-background-color: #0a0a0a;">

    <!-- Background Layer -->
    <VBox alignment="CENTER" spacing="0"
          style="-fx-background-color: 
                 linear-gradient(from 0% 0% to 100% 100%, 
                 #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);"/>
    
    <!-- Main Content Container -->
    <VBox alignment="CENTER" spacing="25" style="-fx-padding: 30px;">
        
        <!-- Logo & Branding Section -->
        <VBox alignment="CENTER" spacing="8">
            <HBox alignment="CENTER" spacing="8">
                <Label text="💪"
                       style="-fx-font-size: 48px;"/>
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="MUSCLE MAP"
                           style="-fx-text-fill: #00f5ff; 
                                  -fx-font-size: 38px; 
                                  -fx-font-weight: bold; 
                                  -fx-letter-spacing: 2px;
                                  -fx-effect: dropshadow(gaussian, rgba(0,245,255,0.7), 12, 0.6, 0, 0);"/>
                    <Label text="PRO FITNESS PLATFORM"
                           style="-fx-text-fill: #ffffff; 
                                  -fx-font-size: 11px; 
                                  -fx-font-weight: 600;
                                  -fx-letter-spacing: 3px;"/>
                </VBox>
            </HBox>
            
            <Label text="Transform Your Body, Transform Your Life"
                   style="-fx-text-fill: #aaaaaa; 
                          -fx-font-size: 13px; 
                          -fx-font-weight: 500;
                          -fx-font-style: italic;"/>
        </VBox>

        <!-- Login Form Container -->
        <VBox alignment="CENTER" spacing="16"
              style="-fx-background-color: rgba(20, 20, 20, 0.95); 
                     -fx-background-radius: 20px; 
                     -fx-padding: 35px 40px; 
                     -fx-effect: dropshadow(gaussian, rgba(0,245,255,0.25), 20, 0, 0, 6);
                     -fx-border-color: rgba(0,245,255,0.4);
                     -fx-border-width: 2px;
                     -fx-border-radius: 20px;"
              maxWidth="420"
              minWidth="420">

            <!-- Form Header -->
            <VBox alignment="CENTER" spacing="6">
                <Label text="🔥 WELCOME BACK 🔥"
                       style="-fx-text-fill: #ffffff; 
                              -fx-font-size: 24px; 
                              -fx-font-weight: bold;
                              -fx-letter-spacing: 1px;"/>
                <Label text="Log in to continue your fitness journey"
                       style="-fx-text-fill: #bbbbbb; 
                              -fx-font-size: 12px; 
                              -fx-font-weight: 500;"/>
            </VBox>

            <!-- Username Field -->
            <VBox spacing="6">
                <Label text="USERNAME"
                       style="-fx-text-fill: #00f5ff; 
                              -fx-font-size: 11px; 
                              -fx-font-weight: bold;
                              -fx-letter-spacing: 1px;"/>
                <TextField fx:id="usernameField"
                           promptText="Enter your username"
                           style="-fx-background-color: rgba(30, 30, 30, 0.9); 
                                  -fx-text-fill: white; 
                                  -fx-prompt-text-fill: #777777; 
                                  -fx-background-radius: 10px; 
                                  -fx-padding: 14px 18px; 
                                  -fx-font-size: 14px;
                                  -fx-font-weight: 500;
                                  -fx-border-color: rgba(0,245,255,0.3); 
                                  -fx-border-width: 1.5px;
                                  -fx-border-radius: 10px;"/>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="6">
                <Label text="PASSWORD"
                       style="-fx-text-fill: #00f5ff; 
                              -fx-font-size: 11px; 
                              -fx-font-weight: bold;
                              -fx-letter-spacing: 1px;"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               style="-fx-background-color: rgba(30, 30, 30, 0.9); 
                                      -fx-text-fill: white; 
                                      -fx-prompt-text-fill: #777777; 
                                      -fx-background-radius: 10px; 
                                      -fx-padding: 14px 18px; 
                                      -fx-font-size: 14px;
                                      -fx-font-weight: 500;
                                      -fx-border-color: rgba(0,245,255,0.3); 
                                      -fx-border-width: 1.5px;
                                      -fx-border-radius: 10px;"/>
            </VBox>

            <!-- Remember Me -->
            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="rememberMeCheckbox"
                          text="Remember me for 30 days"
                          style="-fx-text-fill: #cccccc; 
                                 -fx-font-size: 11px;
                                 -fx-font-weight: 500;"/>
            </HBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel"
                   wrapText="true"
                   style="-fx-text-fill: #ff5555; 
                          -fx-font-size: 11px; 
                          -fx-font-weight: bold;
                          -fx-padding: 8px 12px;
                          -fx-background-color: rgba(255,85,85,0.15);
                          -fx-background-radius: 8px;
                          -fx-border-color: rgba(255,85,85,0.3);
                          -fx-border-width: 1px;
                          -fx-border-radius: 8px;"/>

            <!-- Login Button -->
            <Button fx:id="loginButton"
                    text="🚀 LOGIN NOW"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    style="-fx-background-color: 
                           linear-gradient(to right, #00f5ff 0%, #00b8d4 100%); 
                           -fx-text-fill: white; 
                           -fx-font-size: 16px; 
                           -fx-font-weight: bold; 
                           -fx-letter-spacing: 2px;
                           -fx-background-radius: 12px; 
                           -fx-padding: 16px; 
                           -fx-cursor: hand; 
                           -fx-effect: dropshadow(gaussian, rgba(0,245,255,0.5), 12, 0, 0, 4);"/>

            <!-- Divider -->
            <Separator style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 3px 0;"/>

            <!-- Register Link -->
            <HBox alignment="CENTER" spacing="6">
                <Label text="Don't have an account?"
                       style="-fx-text-fill: #cccccc; 
                              -fx-font-size: 12px;
                              -fx-font-weight: 500;"/>
                <Button fx:id="registerButton"
                        text="CREATE ACCOUNT"
                        onAction="#handleRegister"
                        style="-fx-background-color: transparent; 
                               -fx-text-fill: #00f5ff; 
                               -fx-font-size: 12px; 
                               -fx-font-weight: bold;
                               -fx-underline: true; 
                               -fx-cursor: hand;
                               -fx-padding: 0;"/>
            </HBox>

            <!-- Features Highlight -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 12px 0 0 0;">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="69+"
                           style="-fx-text-fill: #00f5ff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Exercises"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                </VBox>
                <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.2);"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="SMART"
                           style="-fx-text-fill: #00f5ff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Tracking"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                </VBox>
                <Separator orientation="VERTICAL" style="-fx-background-color: rgba(255,255,255,0.2);"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="PRO"
                           style="-fx-text-fill: #00f5ff; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Analytics"
                           style="-fx-text-fill: #aaaaaa; -fx-font-size: 10px;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Footer -->
        <VBox alignment="CENTER" spacing="3">
            <Label text="© 2025 MuscleMap Pro · All rights reserved"
                   style="-fx-text-fill: #666666; 
                          -fx-font-size: 10px;
                          -fx-font-weight: 500;"/>
            <Label text="Built for Champions 🏆"
                   style="-fx-text-fill: #888888; 
                          -fx-font-size: 9px;
                          -fx-font-style: italic;"/>
        </VBox>
    </VBox>
</StackPane>
