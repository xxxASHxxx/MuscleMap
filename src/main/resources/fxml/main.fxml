<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.Node?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.musclemmap.controllers.MainController">

    <!-- Enhanced Top App Bar -->
    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="15.0"
              style="-fx-background-color: #2b2b2b; 
                     -fx-padding: 15px 25px;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 0, 5);
                     -fx-border-color: rgba(0,212,255,0.2);
                     -fx-border-width: 0 0 2px 0;">
            <Label text="💪 MUSCLE MAP"
                   style="-fx-font-size: 24px; 
                          -fx-font-weight: bold; 
                          -fx-text-fill: white;
                          -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.3), 4, 0, 0, 2);" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="logoutButton"
                    text="⚡ Logout"
                    style="-fx-background-color: #ff5555;
                           -fx-text-fill: #FFFFFF;
                           -fx-font-size: 16px;
                           -fx-font-weight: bold;
                           -fx-padding: 12px 28px;
                           -fx-background-radius: 10px;
                           -fx-border-color: rgba(255,255,255,0.3);
                           -fx-border-width: 1px;
                           -fx-border-radius: 10px;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(255,85,85,0.4), 8, 0, 0, 4);" />
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #1a1a1a;">
            <tabs>

                <!-- ========================= HOME TAB ========================= -->
                <Tab fx:id="homeTab" text="🏠 Home">
                    <content>
                        <ScrollPane fitToWidth="true"
                                    style="-fx-background: #0c0c0c; -fx-background-color: #0c0c0c;">
                            <content>
                                <VBox spacing="24.0" style="-fx-padding: 24px; -fx-background-color: #0c0c0c;">

                                    <!-- Enhanced Welcome + Stats Header -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b;
                                                 -fx-padding: 20px;
                                                 -fx-background-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                        <Label fx:id="welcomeLabel"
                                               text="Welcome"
                                               style="-fx-font-size: 32px; 
                                                      -fx-font-weight: bold; 
                                                      -fx-text-fill: #FFFFFF;
                                                      -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.3), 4, 0, 0, 2);"/>
                                        <HBox spacing="20.0" alignment="CENTER_LEFT">
                                            <VBox spacing="8.0">
                                                <Label fx:id="streakLabel"
                                                       text="Current Streak: 0"
                                                       style="-fx-text-fill: #FFD700; 
                                                              -fx-font-weight: bold;
                                                              -fx-font-size: 16px;
                                                              -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.3), 2, 0, 0, 1);"/>
                                                <Label fx:id="lastWorkoutLabel"
                                                       text="Last Workout: --"
                                                       style="-fx-text-fill: #E0E0E0;
                                                              -fx-font-size: 14px;"/>
                                            </VBox>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button fx:id="startQuickWorkoutBtn"
                                                    text="🚀 Start Quick Workout"
                                                    prefWidth="220.0" 
                                                    prefHeight="52.0"
                                                    style="-fx-background-color: #00d4ff;
                                                           -fx-text-fill: white;
                                                           -fx-font-size: 18px;
                                                           -fx-font-weight: bold;
                                                           -fx-background-radius: 12px;
                                                           -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.4), 8, 0, 0, 4);"/>
                                        </HBox>
                                    </VBox>

                                    <Separator />

                                    <!-- Enhanced Quick Cards -->
                                    <HBox spacing="25.0" alignment="CENTER_LEFT">
                                        <VBox fx:id="quickSetCard" spacing="10.0"
                                              style="-fx-background-color: #2b2b2b; 
                                                     -fx-padding: 20px; 
                                                     -fx-background-radius: 15px;
                                                     -fx-border-color: rgba(255,110,199,0.3);
                                                     -fx-border-width: 2px;
                                                     -fx-border-radius: 15px;
                                                     -fx-cursor: hand;
                                                     -fx-effect: dropshadow(gaussian, rgba(255,110,199,0.2), 10, 0, 0, 5);">
                                            <Label text="⚡ Quick Set"
                                                   style="-fx-text-fill: #FFFFFF; 
                                                          -fx-font-weight: bold;
                                                          -fx-font-size: 18px;"/>
                                            <Label text="Log a quick set"
                                                   style="-fx-text-fill: #E0E0E0;
                                                          -fx-font-size: 14px;"/>
                                        </VBox>
                                        <VBox fx:id="progressCard" spacing="10.0"
                                              style="-fx-background-color: #2b2b2b; 
                                                     -fx-padding: 20px; 
                                                     -fx-background-radius: 15px;
                                                     -fx-border-color: rgba(0,212,255,0.3);
                                                     -fx-border-width: 2px;
                                                     -fx-border-radius: 15px;
                                                     -fx-cursor: hand;
                                                     -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                            <Label text="📈 Progress"
                                                   style="-fx-text-fill: #FFFFFF; 
                                                          -fx-font-weight: bold;
                                                          -fx-font-size: 18px;"/>
                                            <Label text="View analytics"
                                                   style="-fx-text-fill: #E0E0E0;
                                                          -fx-font-size: 14px;"/>
                                        </VBox>
                                        <VBox fx:id="muscleMapCard" spacing="10.0"
                                              style="-fx-background-color: #2b2b2b; 
                                                     -fx-padding: 20px; 
                                                     -fx-background-radius: 15px;
                                                     -fx-border-color: rgba(255,215,0,0.3);
                                                     -fx-border-width: 2px;
                                                     -fx-border-radius: 15px;
                                                     -fx-cursor: hand;
                                                     -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.2), 10, 0, 0, 5);">
                                            <Label text="💪 Muscle Map"
                                                   style="-fx-text-fill: #FFFFFF; 
                                                          -fx-font-weight: bold;
                                                          -fx-font-size: 18px;"/>
                                            <Label text="Explore exercises"
                                                   style="-fx-text-fill: #E0E0E0;
                                                          -fx-font-size: 14px;"/>
                                        </VBox>
                                        <VBox fx:id="aiCard" spacing="10.0"
                                              style="-fx-background-color: #2b2b2b; 
                                                     -fx-padding: 20px; 
                                                     -fx-background-radius: 15px;
                                                     -fx-border-color: rgba(255,215,0,0.5);
                                                     -fx-border-width: 3px;
                                                     -fx-border-radius: 15px;
                                                     -fx-cursor: hand;
                                                     -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.4), 15, 0, 0, 8);">
                                            <Label text="🤖 AI Assistant"
                                                   style="-fx-text-fill: #FFD700; 
                                                          -fx-font-weight: bold;
                                                          -fx-font-size: 18px;
                                                          -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.5), 2, 0, 0, 1);"/>
                                            <Label text="Get AI insights"
                                                   style="-fx-text-fill: #E0E0E0;
                                                          -fx-font-size: 14px;"/>
                                        </VBox>
                                    </HBox>

                                    <Separator />

                                    <!-- Enhanced Motivation Section -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b;
                                                 -fx-padding: 20px;
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(255,215,0,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.2), 10, 0, 0, 5);">
                                        <Label text="💡 Today's Motivation"
                                               style="-fx-text-fill: #FFD700; 
                                                      -fx-font-weight: bold;
                                                      -fx-font-size: 20px;
                                                      -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.3), 2, 0, 0, 1);"/>
                                        <Label fx:id="motivationLabel"
                                               text="Keep going!"
                                               wrapText="true"
                                               style="-fx-text-fill: #E0E0E0;
                                                      -fx-font-size: 16px;
                                                      -fx-line-spacing: 2px;"/>
                                    </VBox>

                                    <Separator />

                                    <!-- Enhanced Recent Workouts -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b;
                                                 -fx-padding: 20px;
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(0,212,255,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                        <Label text="📊 Recent Workouts"
                                               style="-fx-font-size: 22px; 
                                                      -fx-font-weight: bold; 
                                                      -fx-text-fill: white;
                                                      -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.3), 2, 0, 0, 1);" />
                                        <VBox fx:id="recentWorkoutsBox" spacing="10.0" />
                                    </VBox>

                                    <Separator />

                                    <!-- Enhanced Achievements -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b;
                                                 -fx-padding: 20px;
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(255,215,0,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.2), 10, 0, 0, 5);">
                                        <Label text="🏆 Recent Achievements"
                                               style="-fx-text-fill: #FFD700; 
                                                      -fx-font-weight: bold;
                                                      -fx-font-size: 22px;
                                                      -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.3), 2, 0, 0, 1);"/>
                                        <HBox fx:id="achievementsBox" spacing="15.0" />
                                    </VBox>

                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- ====================== MUSCLE MAP TAB ====================== -->
                <Tab fx:id="muscleMapTab" text="💪 Muscle Map">
                    <content>
                        <HBox spacing="16.0" style="-fx-padding: 16px; -fx-background-color: transparent;">
                            <!-- Map area -->
                            <VBox spacing="8.0" prefWidth="520.0">
                                <ScrollPane fx:id="muscleMapScrollPane" fitToWidth="true" fitToHeight="true"
                                            style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content>
                                        <Pane fx:id="muscleMapPane" prefWidth="650.0" prefHeight="850.0" />
                                    </content>
                                </ScrollPane>
                            </VBox>

                            <!-- Enhanced Details panel -->
                            <VBox spacing="15.0" HBox.hgrow="ALWAYS" 
                                  style="-fx-padding: 20px;
                                         -fx-background-color: #2b2b2b;
                                         -fx-background-radius: 15px;
                                         -fx-border-color: rgba(0,212,255,0.3);
                                         -fx-border-width: 2px;
                                         -fx-border-radius: 15px;
                                         -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                <Label fx:id="selectedMuscleLabel"
                                       text="🎯 Click on a muscle group to see exercises"
                                       wrapText="true"
                                       style="-fx-text-fill: #00d4ff; 
                                              -fx-font-weight: bold;
                                              -fx-font-size: 18px;
                                              -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.3), 2, 0, 0, 1);"/>

                                <Separator style="-fx-background-color: rgba(0,212,255,0.3);"/>

                                <Label text="🏋️ Exercises for this muscle:"
                                       style="-fx-font-size: 18px; 
                                              -fx-font-weight: bold; 
                                              -fx-text-fill: white;
                                              -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 1, 0, 0, 1);" />
                                <ListView fx:id="exerciseListView" 
                                          prefHeight="300.0"
                                          style="-fx-background-color: #1f1f1f;
                                                 -fx-background-radius: 10px;
                                                 -fx-border-color: rgba(0,212,255,0.2);
                                                 -fx-border-width: 1px;
                                                 -fx-border-radius: 10px;" />

                                <Label text="📋 Exercise Details:"
                                       style="-fx-font-size: 18px; 
                                              -fx-font-weight: bold; 
                                              -fx-text-fill: white;
                                              -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 1, 0, 0, 1);" />
                                
                                <!-- Scrollable Exercise Details Container -->
                                <ScrollPane fitToWidth="true" 
                                           prefHeight="600.0"
                                           style="-fx-background: transparent; 
                                                  -fx-background-color: transparent;
                                                  -fx-border-color: rgba(0,212,255,0.3);
                                                  -fx-border-width: 2px;
                                                  -fx-border-radius: 10px;">
                                    <content>
                                        <VBox spacing="15.0" 
                                              style="-fx-padding: 10px;
                                                     -fx-background-color: transparent;">
                                            
                                            <!-- Exercise Image Display -->
                                            <StackPane fx:id="exerciseImageContainer" 
                                                       prefHeight="180.0"
                                                       maxHeight="180.0"
                                                       style="-fx-background-color: #1f1f1f;
                                                              -fx-background-radius: 10px;
                                                              -fx-border-color: rgba(0,212,255,0.2);
                                                              -fx-border-width: 1px;
                                                              -fx-border-radius: 10px;">
                                                <ImageView fx:id="exerciseImageView" 
                                                           fitWidth="350.0" 
                                                           fitHeight="170.0" 
                                                           preserveRatio="true"
                                                           smooth="true"
                                                           cache="true"
                                                           visible="true" />
                                                <VBox fx:id="imagePlaceholder" 
                                                      alignment="CENTER"
                                                      style="-fx-background-color: #1f1f1f;">
                                                    <Label text="🖼️" 
                                                           style="-fx-font-size: 48px; -fx-text-fill: #666;" />
                                                    <Label text="Exercise Image" 
                                                           style="-fx-text-fill: #888; -fx-font-size: 14px;" />
                                                </VBox>
                                            </StackPane>
                                            
                                            <!-- Exercise Description Text -->
                                            <TextArea fx:id="exerciseDescriptionArea" 
                                                      prefHeight="300.0"
                                                      minHeight="200.0"
                                                      wrapText="true"
                                                      style="-fx-background-color: #1f1f1f;
                                                             -fx-text-fill: white;
                                                             -fx-background-radius: 10px;
                                                             -fx-border-color: rgba(0,212,255,0.2);
                                                             -fx-border-width: 1px;
                                                             -fx-border-radius: 10px;
                                                             -fx-font-size: 14px;" />
                                            
                                            <!-- Step-by-Step Images Panel -->
                                            <VBox fx:id="stepImagesPanel" 
                                                  spacing="10.0"
                                                  visible="false"
                                                  managed="false"
                                                  style="-fx-background-color: #1f1f1f;
                                                         -fx-background-radius: 15px;
                                                         -fx-border-color: #00d4ff;
                                                         -fx-border-width: 2px;
                                                         -fx-border-radius: 15px;
                                                         -fx-padding: 15px;" />
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </VBox>
                        </HBox>
                    </content>
                </Tab>

                <!-- ======================== WORKOUT TAB ======================= -->
                <Tab fx:id="workoutTab" text="🏋️ Workout">
                    <content>
                        <ScrollPane fitToWidth="true"
                                    style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a;">
                            <content>
                                <VBox spacing="20.0" style="-fx-padding: 25px; -fx-background-color: #1a1a1a;">

                                    <!-- Enhanced Controls -->
                                    <HBox spacing="20.0" alignment="CENTER_LEFT"
                                          style="-fx-background-color: #2b2b2b; 
                                                 -fx-padding: 25px; 
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(0,212,255,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                        <Label text="🎯 Select Routine:"
                                               style="-fx-text-fill: white; 
                                                      -fx-font-size: 18px; 
                                                      -fx-font-weight: bold;
                                                      -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 1, 0, 0, 1);" />
                                        <ComboBox fx:id="routineSelector" 
                                                  prefWidth="220.0"
                                                  style="-fx-background-color: #353535;
                                                         -fx-text-fill: white;
                                                         -fx-background-radius: 10px;
                                                         -fx-border-color: rgba(0,212,255,0.3);
                                                         -fx-border-width: 1px;
                                                         -fx-border-radius: 10px;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="startWorkoutBtn" 
                                                text="▶️ Start Workout" 
                                                prefWidth="180.0"
                                                prefHeight="45.0"
                                                style="-fx-background-color: #00d4ff;
                                                       -fx-text-fill: white;
                                                       -fx-font-size: 16px;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 12px;
                                                       -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.4), 8, 0, 0, 4);" />
                                        <Button fx:id="endWorkoutBtn" 
                                                text="⏹️ End Workout" 
                                                prefWidth="180.0"
                                                prefHeight="45.0"
                                                disable="true"
                                                style="-fx-background-color: #ff5555;
                                                       -fx-text-fill: white;
                                                       -fx-font-size: 16px;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 12px;
                                                       -fx-effect: dropshadow(gaussian, rgba(255,85,85,0.4), 8, 0, 0, 4);" />
                                    </HBox>

                                    <!-- Enhanced Timer -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b; 
                                                 -fx-padding: 25px; 
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(255,215,0,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.2), 10, 0, 0, 5);">
                                        <Label fx:id="workoutTimerLabel"
                                               text="⏱️ Ready to start your workout!"
                                               style="-fx-font-size: 22px; 
                                                      -fx-font-weight: bold; 
                                                      -fx-text-fill: #FFD700;
                                                      -fx-effect: dropshadow(gaussian, rgba(255,215,0,0.3), 2, 0, 0, 1);" />
                                    </VBox>

                                    <!-- Enhanced Exercise Selection -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b;
                                                 -fx-padding: 20px;
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(0,212,255,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                        <Label text="🏋️ Select Exercise"
                                               style="-fx-font-size: 22px; 
                                                      -fx-font-weight: bold; 
                                                      -fx-text-fill: white;
                                                      -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 1, 0, 0, 1);" />
                                        <ComboBox fx:id="exerciseComboBox" 
                                                  prefWidth="300.0"
                                                  style="-fx-background-color: #353535;
                                                         -fx-text-fill: white;
                                                         -fx-background-radius: 10px;
                                                         -fx-border-color: rgba(0,212,255,0.3);
                                                         -fx-border-width: 1px;
                                                         -fx-border-radius: 10px;" />
                                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                                            <Label text="Sets:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                            <TextField fx:id="setsField" 
                                                       prefWidth="80.0"
                                                       promptText="3"
                                                       style="-fx-background-color: #353535;
                                                              -fx-text-fill: white;
                                                              -fx-background-radius: 8px;
                                                              -fx-border-color: rgba(0,212,255,0.3);
                                                              -fx-border-width: 1px;
                                                              -fx-border-radius: 8px;" />
                                            <Label text="Reps:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                            <TextField fx:id="repsField" 
                                                       prefWidth="80.0"
                                                       promptText="12"
                                                       style="-fx-background-color: #353535;
                                                              -fx-text-fill: white;
                                                              -fx-background-radius: 8px;
                                                              -fx-border-color: rgba(0,212,255,0.3);
                                                              -fx-border-width: 1px;
                                                              -fx-border-radius: 8px;" />
                                            <Label text="Weight:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                            <TextField fx:id="weightField" 
                                                       prefWidth="80.0"
                                                       promptText="50"
                                                       style="-fx-background-color: #353535;
                                                              -fx-text-fill: white;
                                                              -fx-background-radius: 8px;
                                                              -fx-border-color: rgba(0,212,255,0.3);
                                                              -fx-border-width: 1px;
                                                              -fx-border-radius: 8px;" />
                                            <Button fx:id="addSetBtn" 
                                                    text="➕ Add Set"
                                                    prefWidth="120.0"
                                                    style="-fx-background-color: #4CAF50;
                                                           -fx-text-fill: white;
                                                           -fx-font-weight: bold;
                                                           -fx-background-radius: 10px;
                                                           -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.4), 8, 0, 0, 4);" />
                                        </HBox>
                                    </VBox>

                                    <!-- Enhanced Exercise Log Input -->
                                    <VBox spacing="15.0"
                                          style="-fx-background-color: #2b2b2b;
                                                 -fx-padding: 20px;
                                                 -fx-background-radius: 15px;
                                                 -fx-border-color: rgba(0,212,255,0.3);
                                                 -fx-border-width: 2px;
                                                 -fx-border-radius: 15px;
                                                 -fx-effect: dropshadow(gaussian, rgba(0,212,255,0.2), 10, 0, 0, 5);">
                                        <Label text="💪 Exercise Log"
                                               style="-fx-font-size: 22px; 
                                                      -fx-font-weight: bold; 
                                                      -fx-text-fill: white;
                                                      -fx-effect: dropshadow(gaussian, rgba(255,255,255,0.2), 1, 0, 0, 1);" />
                                        <ScrollPane fitToWidth="true" 
                                                    prefHeight="400.0" 
                                                    style="-fx-background: transparent;
                                                           -fx-border-color: rgba(0,212,255,0.2);
                                                           -fx-border-width: 1px;
                                                           -fx-border-radius: 10px;">
                                            <content>
                                                <VBox fx:id="exerciseLogBox" spacing="15.0" />
                                            </content>
                                        </ScrollPane>
                                    </VBox>

                                </VBox>
