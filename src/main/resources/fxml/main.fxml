<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musclemmap.controllers.MainController">
    <top>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #2b2b2b; -fx-padding: 10px 20px;">
            <Label text="💪 Muscle Map" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="logoutButton" text="⚡ Logout" style="-fx-background-color: linear-gradient(to right, #ff5555, #ff3333); -fx-text-fill: #FFFFFF; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10px 24px; -fx-background-radius: 8px; -fx-border-color: #FFFFFF; -fx-border-width: 2px; -fx-border-radius: 8px; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 6, 0, 0, 3);"/>
        </HBox>
    </top>

        </HBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #1a1a1a;">
            <tabs>
                <!-- HOME TAB -->
                <Tab fx:id="homeTab" text="Home">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: #0c0c0c; -fx-background-color: #0c0c0c;">
                            <content>
                                <VBox spacing="20.0" style="-fx-padding: 24px; -fx-background-color: #0c0c0c;">
                                    <VBox spacing="8.0" style="-fx-padding: 10px;">
                                        <Label fx:id="welcomeLabel" text="Welcome" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                                            <VBox>
                                                <Label fx:id="streakLabel" text="Current Streak: 0" style="-fx-text-fill: #FFD700; -fx-font-weight: bold;"/>
                                                <Label fx:id="lastWorkoutLabel" text="Last Workout: --" style="-fx-text-fill: #E0E0E0;"/>
                                            </VBox>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button fx:id="startQuickWorkoutBtn" text="⚡ Start Workout" />
                                        </HBox>
                                    </VBox>

                                    <HBox spacing="20.0" alignment="CENTER_LEFT">
                                        <VBox fx:id="quickSetCard" spacing="8.0" style="-fx-background-color:#1f1f1f; -fx-padding: 14px; -fx-background-radius:12px;">
                                            <Label text="⚡ Quick Set" style="-fx-text-fill: #FFFFFF; -fx-font-weight:bold;"/>
                                            <Label text="Log a quick set" style="-fx-text-fill: #E0E0E0;"/>
                                        </VBox>
                                        <VBox fx:id="progressCard" spacing="8.0" style="-fx-background-color:#1f1f1f; -fx-padding: 14px; -fx-background-radius:12px;">
                                            <Label text="📈 Progress" style="-fx-text-fill: #FFFFFF; -fx-font-weight:bold;"/>
                                            <Label text="View analytics" style="-fx-text-fill: #E0E0E0;"/>
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="12.0">
                                        <Label text="💡 Today's Motivation" style="-fx-text-fill: #FFFFFF; -fx-font-weight:bold;"/>
                                        <Label fx:id="motivationLabel" text="Keep going!" wrapText="true" style="-fx-text-fill: #E0E0E0;"/>
                                    </VBox>

                                    <VBox spacing="12.0">
                                        <Label text="🏆 Recent Achievements" style="-fx-text-fill: #FFFFFF; -fx-font-weight:bold;"/>
                                        <HBox fx:id="achievementsBox" spacing="10.0" />
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- MUSCLE MAP TAB -->
                <Tab fx:id="muscleMapTab" text="💪 Muscle Map">
                    <content>
                        <HBox spacing="20.0" style="-fx-padding: 16px; -fx-background-color: transparent;">
                            <VBox spacing="8.0" prefWidth="520.0">
                                <ScrollPane fx:id="muscleMapScrollPane" fitToWidth="true" fitToHeight="true">
                                    <content>
                                        <Pane fx:id="muscleMapPane" prefWidth="500.0" prefHeight="700.0" />
                                    </content>
                                </ScrollPane>
                            </VBox>
                            <VBox spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-padding:12px;">
                                <Label fx:id="selectedMuscleLabel" text="Selected Muscle" style="-fx-text-fill:#00d4ff; -fx-font-weight:bold;"/>
                                <ListView fx:id="exerciseListView" prefHeight="300.0" />
                                <StackPane fx:id="exerciseImageContainer" prefHeight="220.0">
                                    <ImageView fx:id="exerciseImageView" fitHeight="200.0" preserveRatio="true" />
                                </StackPane>
                                <TextArea fx:id="exerciseDescriptionArea" wrapText="true" prefRowCount="6" />
                            </VBox>
                        </HBox>
                    </content>
                </Tab>

                <!-- WORKOUT TAB -->
                <Tab fx:id="workoutTab" text="🏋️ Workout">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a;">
                            <content>
                                <VBox spacing="20.0" style="-fx-padding: 25px; -fx-background-color: #1a1a1a;">

                                    <!-- Workout Control Section -->
                                    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label text="🎯 Select Routine:" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="routineSelector" prefWidth="180.0" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="startWorkoutBtn" text="▶️ Start Workout" prefWidth="140.0" onAction="#handleStartWorkout" />
                                        <Button fx:id="endWorkoutBtn" text="⏹️ End Workout" prefWidth="140.0" onAction="#handleEndWorkout" disable="true" />
                                    </HBox>

                                    <!-- Timer Display -->
                                    <VBox spacing="15.0" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label fx:id="workoutTimerLabel" text="⏱️ Timer: 00:00:00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                        <Label fx:id="currentWorkoutStatsLabel" text="Start a workout to begin logging!" style="-fx-font-size: 14px; -fx-text-fill: #b0b0b0;" wrapText="true" />
                                    </VBox>

                                    <!-- Exercise Input Section -->
                                    <VBox spacing="15.0" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label text="➕ Log Exercise Set" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />

                                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                                            <Label text="Exercise:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                            <ComboBox fx:id="exerciseComboBox" prefWidth="250.0" promptText="Select exercise..." />
                                        </HBox>

                                        <HBox spacing="15.0" alignment="CENTER_LEFT">
                                            <VBox spacing="5.0">
                                                <Label text="Weight (lbs):" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                                <TextField fx:id="weightField" prefWidth="120.0" promptText="e.g., 135" />
                                            </VBox>

                                            <VBox spacing="5.0">
                                                <Label text="Reps:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                                <TextField fx:id="repsField" prefWidth="120.0" promptText="e.g., 10" />
                                            </VBox>

                                            <Region HBox.hgrow="ALWAYS" />

                                            <Button text="✅ Log Set" onAction="#handleLogSet" prefWidth="120.0" prefHeight="40.0"
                                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px;" />
                                        </HBox>
                                    </VBox>

                                    <!-- Exercise Log Display -->
                                    <VBox spacing="10.0">
                                        <Label text="💪 Exercise Log" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                        <ScrollPane fitToWidth="true" prefHeight="400.0" style="-fx-background: transparent;">
                                            <content>
                                                <VBox fx:id="exerciseLogBox" spacing="12.0" />
                                            </content>
                                        </ScrollPane>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- PROGRESS TAB -->
                <Tab fx:id="progressTab" text="Progress">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a;">
                            <content>
                                <VBox spacing="25.0" style="-fx-padding: 25px; -fx-background-color: #1a1a1a;">

                                    <!-- Filter Controls -->
                                    <HBox spacing="15.0" alignment="CENTER_LEFT"
                                          style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label text="📊 Filter:" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                                        <ComboBox fx:id="exerciseFilterCombo" prefWidth="180.0"/>

                                        <Label text="From:" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                                        <DatePicker fx:id="fromDatePicker"/>

                                        <Label text="To:" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                                        <DatePicker fx:id="toDatePicker"/>

                                        <Button fx:id="refreshProgressButton" text="🔄 Refresh"
                                                onAction="#handleRefreshProgress"
                                                style="-fx-background-color: #00d4ff; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-padding: 8px 16px;
                                       -fx-background-radius: 8px; -fx-cursor: hand;"/>
                                    </HBox>

                                    <!-- Overview Stats Cards Container -->
                                    <VBox fx:id="progressStatsContainer" spacing="15.0"/>

                                    <!-- Charts Section -->
                                    <VBox spacing="20.0">
                                        <Label text="📈 Progress Analytics"
                                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                                        <!-- Volume Line Chart -->
                                        <LineChart fx:id="volumeChart" prefHeight="300.0"
                                                   style="-fx-background-color: #2b2b2b; -fx-border-radius: 12px;">
                                            <xAxis>
                                                <CategoryAxis side="BOTTOM" label="Time Period"/>
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis side="LEFT" label="Volume (lbs)"/>
                                            </yAxis>
                                        </LineChart>

                                        <!-- Exercise Bar Chart -->
                                        <BarChart fx:id="exerciseChart" prefHeight="300.0"
                                                  style="-fx-background-color: #2b2b2b; -fx-border-radius: 12px;">
                                            <xAxis>
                                                <CategoryAxis side="BOTTOM" label="Exercise"/>
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis side="LEFT" label="Total Volume (lbs)"/>
                                            </yAxis>
                                        </BarChart>

                                        <!-- Progress Area Chart -->
                                        <AreaChart fx:id="progressChart" prefHeight="250.0"
                                                   style="-fx-background-color: #2b2b2b; -fx-border-radius: 12px;">
                                            <xAxis>
                                                <CategoryAxis side="BOTTOM" label="Week"/>
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis side="LEFT" label="Workouts"/>
                                            </yAxis>
                                        </AreaChart>
                                    </VBox>

                                    <!-- Personal Records Section -->
                                    <VBox spacing="15.0">
                                        <Label text="🏆 Personal Records"
                                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                                        <VBox fx:id="personalRecordsContainer" spacing="10.0"/>

                                        <TableView fx:id="prTableView" prefHeight="250.0"
                                                   style="-fx-background-color: #2b2b2b;">
                                            <columns>
                                                <TableColumn fx:id="exerciseColumn" text="Exercise" prefWidth="200.0"/>
                                                <TableColumn fx:id="weightColumn" text="Max Weight" prefWidth="150.0"/>
                                                <TableColumn fx:id="dateColumn" text="Achieved" prefWidth="150.0"/>
                                            </columns>
                                        </TableView>
                                    </VBox>

                                    <!-- Consistency Stats -->
                                    <VBox spacing="15.0">
                                        <Label text="🔥 Consistency Tracking"
                                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                                        <VBox fx:id="bodyMetricsContainer" spacing="15.0"/>
                                    </VBox>

                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <!-- AI TAB -->
                <Tab fx:id="aiTab" text="AI">
                    <content>
                        <VBox fx:id="aiContentContainer" spacing="16.0" style="-fx-padding: 20px; -fx-background-color: #1a1a1a;">
                            <!-- AI content will be injected here by MainController -->
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
