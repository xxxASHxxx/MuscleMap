<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musclemmap.controllers.MainController">
    <top>
        <HBox alignment="CENTER_RIGHT"
              spacing="15.0"
              style="-fx-background-color: #2b2b2b; -fx-padding: 10px 20px;">

            <!-- App Title -->
            <Label text="💪 Muscle Map"
                   style="-fx-font-size: 20px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;" />

            <!-- Spacer to push logout button to right -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Logout Button -->
            <!-- Logout Button - FIXED VISIBILITY -->
            <Button fx:id="logoutButton" text="⚡ Logout"
                    style="-fx-background-color: linear-gradient(to right, #ff5555, #ff3333);
               -fx-text-fill: #FFFFFF;
               -fx-font-size: 16px;
               -fx-font-weight: bold;
               -fx-padding: 10px 24px;
               -fx-background-radius: 8px;
               -fx-border-color: #FFFFFF;
               -fx-border-width: 2px;
               -fx-border-radius: 8px;
               -fx-cursor: hand;
               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 6, 0, 0, 3);"/>

        </HBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #1a1a1a;">
            <tabs>
                <Tab fx:id="homeTab" text="🏠 Home">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a;">
                            <content>
                                <VBox spacing="25.0" style="-fx-padding: 30px; -fx-background-color: #1a1a1a;">
                                    <Label fx:id="welcomeLabel" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />

                                    <HBox spacing="40.0">
                                        <VBox spacing="8.0">
                                            <Label fx:id="streakLabel" style="-fx-font-size: 18px; -fx-text-fill: #4CAF50; -fx-font-weight: bold;" />
                                            <Label fx:id="lastWorkoutLabel" style="-fx-font-size: 14px; -fx-text-fill: #b0b0b0;" />
                                        </VBox>
                                        <Button fx:id="startQuickWorkoutBtn" text="🚀 Start Quick Workout" prefWidth="200.0" prefHeight="50.0" />
                                    </HBox>

                                    <Separator style="-fx-background-color: #555555;" />

                                    <VBox spacing="15.0">
                                        <Label text="📊 Recent Workouts" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                        <VBox fx:id="recentWorkoutsBox" spacing="8.0" />
                                    </VBox>

                                    <Separator style="-fx-background-color: #555555;" />

                                    <VBox spacing="15.0">
                                        <Label text="🎯 Quick Stats" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                        <HBox spacing="30.0">
                                            <VBox spacing="5.0" style="-fx-background-color: #2b2b2b; -fx-padding: 15px; -fx-background-radius: 10px;">
                                                <Label text="💪" style="-fx-font-size: 24px;" />
                                                <Label text="156" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                                                <Label text="Total Workouts" style="-fx-font-size: 12px; -fx-text-fill: #b0b0b0;" />
                                            </VBox>
                                            <VBox spacing="5.0" style="-fx-background-color: #2b2b2b; -fx-padding: 15px; -fx-background-radius: 10px;">
                                                <Label text="🏋️" style="-fx-font-size: 24px;" />
                                                <Label text="127K" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2196F3;" />
                                                <Label text="Total Volume (lbs)" style="-fx-font-size: 12px; -fx-text-fill: #b0b0b0;" />
                                            </VBox>
                                            <VBox spacing="5.0" style="-fx-background-color: #2b2b2b; -fx-padding: 15px; -fx-background-radius: 10px;">
                                                <Label text="🔥" style="-fx-font-size: 24px;" />
                                                <Label text="21" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FF5722;" />
                                                <Label text="Best Streak (days)" style="-fx-font-size: 12px; -fx-text-fill: #b0b0b0;" />
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <Tab fx:id="muscleMapTab" text="💪 Muscle Map">
                    <content>
                        <HBox spacing="15.0" style="-fx-background-color: #1a1a1a; -fx-padding: 15px;">
                            <ScrollPane fx:id="muscleMapScrollPane" fitToWidth="true" fitToHeight="true" prefWidth="700.0" style="-fx-background: transparent; -fx-background-color: transparent;">
                                <content>
                                    <Pane fx:id="muscleMapPane" prefWidth="650.0" prefHeight="850.0" />
                                </content>
                            </ScrollPane>

                            <VBox spacing="15.0" prefWidth="450.0" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 15px;">
                                <Label fx:id="selectedMuscleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" wrapText="true" />

                                <Separator style="-fx-background-color: #555555;" />

                                <Label text="🏋️ Exercises for this muscle:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                <ListView fx:id="exerciseListView" prefHeight="250.0" />

                                <Label text="📋 Exercise Details:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                <TextArea fx:id="exerciseDescriptionArea" prefHeight="220.0" wrapText="true" />
                            </VBox>
                        </HBox>
                    </content>
                </Tab>

                <Tab fx:id="workoutTab" text="🏋️ Workout">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a;">
                            <content>
                                <VBox spacing="20.0" style="-fx-padding: 25px; -fx-background-color: #1a1a1a;">
                                    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label text="🎯 Select Routine:" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="routineSelector" prefWidth="180.0" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="startWorkoutBtn" text="▶️ Start Workout" prefWidth="140.0" />
                                        <Button fx:id="endWorkoutBtn" text="⏹️ End Workout" prefWidth="140.0" />
                                    </HBox>

                                    <VBox spacing="15.0" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label fx:id="workoutTimerLabel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                    </VBox>

                                    <VBox spacing="10.0">
                                        <Label text="💪 Exercise Log" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                        <ScrollPane fitToWidth="true" prefHeight="400.0" style="-fx-background: transparent;">
                                            <content>
                                                <VBox fx:id="exerciseLogBox" spacing="12.0" />
                                            </content>
                                        </ScrollPane>
                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>

                <Tab fx:id="progressTab" text="📊 Progress">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a1a; -fx-background-color: #1a1a1a;">
                            <content>
                                <VBox spacing="25.0" style="-fx-padding: 25px; -fx-background-color: #1a1a1a;">
                                    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: #2b2b2b; -fx-padding: 20px; -fx-background-radius: 12px;">
                                        <Label text="📈 Filter:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="exerciseFilterCombo" prefWidth="150.0" />
                                        <Label text="📅 From:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                        <DatePicker fx:id="fromDatePicker" />
                                        <Label text="To:" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                        <DatePicker fx:id="toDatePicker" />
                                    </HBox>

                                    <VBox spacing="15.0">
                                        <Label text="🏆 Your Progress Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />
                                        <VBox fx:id="progressChartsBox" spacing="15.0" style="-fx-padding: 20px;"/>


                                    </VBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
